{
  "name": "holographic-opencode-plugin",
  "version": "1.0.0",
  "description": "Native OpenCode plugin for holographic memory with HRR retrieval",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublish": "npm run build",
    "install": "npm run build",
    "migrate": "npx tsx scripts/migrate-to-opencode.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "holographic-memory",
    "hrr",
    "memory"
  ],
  "author": "tw2818",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.14.29"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.14.29",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3"
  }
}
