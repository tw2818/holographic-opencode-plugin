  "repository": {
    "type": "git",
    "url": "git+https://github.com/tw2818/holographic-opencode-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/tw2818/holographic-opencode-plugin/issues"
  },
  "homepage": "https://github.com/tw2818/holographic-opencode-plugin#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.14.29"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.14.29",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3"
